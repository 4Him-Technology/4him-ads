# ============================================================
# 4him Ads — modelo de variáveis de ambiente
# Copie para `.env` e preencha. O `.env` real nunca vai para o Git.
#
# REGRA DE SEGURANÇA: nenhuma variável aqui é exposta ao navegador.
# O Vite só embutiria variáveis com prefixo `VITE_` — e elas ficam
# LEGÍVEIS no bundle público (verificado na prática). Por isso não
# usamos nenhuma: o front conversa apenas com a nossa API via `/api`.
# ============================================================

# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 🔴 service_role ignora RLS — só no servidor, nunca compartilhar.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres (Connect → Session pooler) — só para `npm run db:migrate`.
SUPABASE_DB_URL=

# --- Geração de criativos por IA (fal.ai — um agregador, dezenas de modelos) ---
# Conta em fal.ai → Keys. Sem isto, a geração devolve aviso claro.
FAL_KEY=

# --- E-mail (Resend). Sem isto, o sistema registra o envio e não envia. ---
RESEND_API_KEY=
# Remetente verificado no provedor. Ex.: 4Him Ads <ads@4him.com.br>
EMAIL_FROM=
# Endereço público do sistema — usado nos links dos e-mails.
APP_URL=http://localhost:5174

# --- Asaas (cobrança recorrente) ---
# Chave em: painel Asaas → perfil → Integrações → Chave de API.
# Use o sandbox (sandbox.asaas.com) até validar tudo.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token combinado no cadastro do webhook, para autenticar quem nos chama.
ASAAS_WEBHOOK_TOKEN=

# --- Meta Marketing API (developers.facebook.com → App → Básico) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:3333/connect/meta/callback
# Escrita exige App Review aprovado pela Meta.
META_WRITE_ENABLED=false

# --- Segredos da aplicação (gerar valores próprios, NÃO reaproveitar) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Criptografa tokens de plataforma no banco. Perder = reconectar todas as contas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Aplicação ---
# API_PORT   → porta da nossa API.
# WEB_ORIGIN → único endereço aceito pela API (CORS).
API_PORT=3333
WEB_ORIGIN=http://localhost:5174
